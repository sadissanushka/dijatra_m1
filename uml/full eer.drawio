<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="jAAyPcmjGucsDhFKZGe6">
    <mxGraphModel dx="5675" dy="3103" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% =========================================================================\n    %% CORE SCHEMA (Module 4 - Amaraweera MTP - Shared Foundation)\n    %% =========================================================================\n    CORE_COMPANIES {\n        bigint id PK\n        text name\n        text_array email_domains \&quot;Allowed OTP domains\&quot;\n        timestamptz created_at\n    }\n\n    CORE_USERS {\n        bigint id PK\n        bigint company_id FK\n        citext email UK\n        text full_name\n        text role \&quot;DISCRIMINATOR: employee | driver | admin | policymaker\&quot;\n        text gender\n        text phone\n        boolean corporate_verified\n        timestamptz created_at\n        timestamptz updated_at\n    }\n\n    CORE_TRIPS {\n        bigint id PK\n        text kind \&quot;DISCRIMINATOR (d): carpool | shuttle\&quot;\n        bigint company_id FK\n        bigint driver_user_id FK\n        text status \&quot;scheduled | boarding | in_progress | completed | cancelled\&quot;\n        timestamptz planned_start\n        timestamptz started_at\n        timestamptz ended_at\n        timestamptz created_at\n    }\n\n    CORE_TRIP_PARTICIPANTS {\n        bigint trip_id PK, FK\n        bigint user_id PK, FK\n        text role \&quot;driver | rider\&quot;\n        timestamptz joined_at\n    }\n\n    %% =========================================================================\n    %% AUTH SCHEMA (Module 2 - Chamara WPR - Identity &amp; Security)\n    %% =========================================================================\n    AUTH_CREDENTIALS {\n        bigint user_id PK, FK \&quot;1:1 Weak Entity\&quot;\n        text password_hash \&quot;bcrypt / argon2id\&quot;\n        text refresh_token_hash\n        timestamptz last_login_at\n        int failed_attempts\n        timestamptz locked_until\n        timestamptz created_at\n        timestamptz updated_at\n    }\n\n    AUTH_REFRESH_TOKENS {\n        bigint id PK\n        bigint user_id FK\n        text token_hash UK \&quot;SHA-256 rotated token\&quot;\n        timestamptz expires_at\n        boolean revoked\n        timestamptz created_at\n    }\n\n    %% =========================================================================\n    %% BOOKING SCHEMA (Module 2 - Chamara WPR - Fleet &amp; Seat Allocation)\n    %% =========================================================================\n    BOOKING_VEHICLES {\n        bigint id PK\n        bigint company_id FK\n        text plate_no UK\n        text type \&quot;Coaster | HiAce | Civilian\&quot;\n        int capacity \&quot;CHECK (capacity &gt; 0)\&quot;\n        jsonb seat_layout_json\n        boolean active\n        timestamptz created_at\n    }\n\n    BOOKING_SEATS {\n        bigint id PK\n        bigint vehicle_id FK \&quot;Identifying Parent (UQ vehicle_id, seat_label)\&quot;\n        text seat_label \&quot;1A, 1B, 2A...\&quot;\n        int row_no\n        int col_no\n        boolean is_window\n        boolean is_aisle\n        boolean is_accessible\n    }\n\n    BOOKING_DRIVERS {\n        bigint id PK\n        bigint user_id UK, FK \&quot;SUBTYPE of core.users (role=driver)\&quot;\n        text licence_no\n        bigint company_id FK\n        boolean active\n        timestamptz created_at\n    }\n\n    BOOKING_SHUTTLE_ROUTES {\n        bigint id PK\n        bigint company_id FK\n        text name\n        text origin_name\n        text destination_name\n        jsonb stops_json\n        float distance_m\n        int estimated_duration_s\n        boolean active\n        timestamptz created_at\n    }\n\n    BOOKING_SHUTTLE_TRIPS {\n        bigint id PK \&quot;SUBTYPE of core.trips (kind=shuttle)\&quot;\n        bigint route_id FK\n        bigint vehicle_id FK\n        bigint driver_id FK\n        timestamptz depart_at\n        timestamptz arrive_at\n        text status \&quot;scheduled | boarding | in_progress | completed | cancelled\&quot;\n        timestamptz booking_cutoff_at\n        int version \&quot;Optimistic locking\&quot;\n        timestamptz created_at\n    }\n\n    BOOKING_BOOKINGS {\n        bigint id PK\n        bigint trip_id FK \&quot;UQ active (trip_id, user_id)\&quot;\n        bigint user_id FK\n        int party_size \&quot;CHECK (1..6)\&quot;\n        text status \&quot;held | confirmed | cancelled | waitlisted | no_show\&quot;\n        uuid idempotency_key\n        timestamptz created_at\n        timestamptz updated_at\n        int version\n    }\n\n    BOOKING_SEAT_ASSIGNMENTS {\n        bigint id PK\n        bigint booking_id FK\n        bigint trip_id FK \&quot;UQ active (trip_id, seat_id)\&quot;\n        bigint seat_id FK\n        text status \&quot;active | released\&quot;\n        timestamptz assigned_at\n    }\n\n    BOOKING_WAITLIST_ENTRIES {\n        bigint id PK\n        bigint trip_id FK\n        bigint user_id FK\n        int party_size\n        text status \&quot;waiting | promoted | expired | cancelled\&quot;\n        timestamptz created_at\n    }\n\n    BOOKING_SEAT_HOLDS {\n        bigint id PK\n        bigint trip_id FK\n        bigint seat_id FK\n        bigint user_id FK\n        timestamptz expires_at \&quot;TTL +5 min\&quot;\n        timestamptz created_at\n    }\n\n    BOOKING_BOOKING_AUDIT {\n        bigint id PK\n        bigint booking_id FK\n        text from_status\n        text to_status\n        bigint actor_id FK\n        text reason\n        timestamptz created_at\n    }\n\n    BOOKING_IDEMPOTENCY_KEYS {\n        bigint user_id PK, FK\n        text key PK\n        text request_hash \&quot;SHA-256 payload hash\&quot;\n        jsonb response_json\n        timestamptz created_at\n    }\n\n    BOOKING_DOMAIN_EVENTS {\n        bigint id PK\n        text event_type \&quot;booking.confirmed | cancelled | promoted | no_show\&quot;\n        jsonb payload\n        boolean published\n        timestamptz created_at\n    }\n\n    %% =========================================================================\n    %% ROUTING SCHEMA (Module 1 - Thisera WSSA - Road Graph &amp; Ride Matching)\n    %% =========================================================================\n    ROUTING_ROAD_NODES {\n        bigint id PK \&quot;OSM Node ID\&quot;\n        geometry_point_4326 geom \&quot;GiST Spatial Index\&quot;\n    }\n\n    ROUTING_ROAD_EDGES {\n        bigint id PK\n        bigint source FK \&quot;road_nodes(id)\&quot;\n        bigint target FK \&quot;road_nodes(id)\&quot;\n        float distance_m\n        float speed_kmh\n        boolean is_oneway\n        geometry_linestring_4326 geom \&quot;GiST Spatial Index\&quot;\n    }\n\n    ROUTING_RIDE_OFFERS {\n        bigint id PK\n        bigint user_id FK \&quot;Driver User\&quot;\n        geometry_point_4326 origin \&quot;GiST Index\&quot;\n        geometry_point_4326 destination \&quot;GiST Index\&quot;\n        timestamptz time_window_start\n        timestamptz time_window_end\n        boolean recurring\n        boolean women_only\n        timestamptz created_at\n    }\n\n    ROUTING_RIDE_REQUESTS {\n        bigint id PK\n        bigint user_id FK \&quot;Rider User\&quot;\n        geometry_point_4326 origin \&quot;GiST Index\&quot;\n        geometry_point_4326 destination \&quot;GiST Index\&quot;\n        timestamptz time_window_start\n        timestamptz time_window_end\n        timestamptz created_at\n    }\n\n    ROUTING_MATCHES {\n        bigint id PK \&quot;Associative Entity (Carpool Subtype)\&quot;\n        bigint offer_id FK\n        bigint request_id FK\n        float overlap_pct\n        float detour_added_m \&quot;Must be &lt;= 2500m\&quot;\n        text status \&quot;proposed | confirmed | rejected\&quot;\n        timestamptz created_at\n    }\n\n    %% =========================================================================\n    %% WALLET &amp; CARBON SCHEMA (Module 3 - Zainy TNS - Ledger &amp; Emissions)\n    %% =========================================================================\n    WALLET_FUEL_TYPES {\n        serial id PK\n        text code UK \&quot;PETROL_92 | AUTO_DIESEL | ELECTRIC | HYBRID\&quot;\n        text name\n        text unit \&quot;litre | kWh\&quot;\n    }\n\n    WALLET_VEHICLE_TYPES {\n        serial id PK\n        text name \&quot;Small Car | Sedan | SUV | Van | Minibus\&quot;\n        int fuel_type_id FK\n        float avg_km_per_litre\n        int default_occupancy\n    }\n\n    WALLET_VEHICLES_REGISTRY {\n        bigint id PK\n        bigint owner_user_id FK \&quot;core.users(id)\&quot;\n        int vehicle_type_id FK\n        text reg_no UK\n        float km_per_litre_override\n        int seats\n        timestamptz created_at\n    }\n\n    WALLET_EMISSION_FACTORS {\n        serial id PK\n        int fuel_type_id FK\n        int vehicle_type_id FK\n        float kg_co2e_per_litre\n        float kg_co2e_per_km\n        text source \&quot;UK DEFRA 2024 | SLSEA CEB\&quot;\n        int source_year\n        text region \&quot;LK | GLOBAL | UK\&quot;\n        timestamptz created_at\n    }\n\n    WALLET_FUEL_PRICES {\n        serial id PK\n        int fuel_type_id FK\n        int price_minor_per_litre \&quot;LKR cents (e.g. 33200)\&quot;\n        timestamptz effective_from\n        text source \&quot;CPC / Lanka IOC\&quot;\n        timestamptz created_at\n    }\n\n    WALLET_ACCOUNTS {\n        bigint id PK\n        text owner_type \&quot;DISCRIMINATOR (d): user | company | system\&quot;\n        bigint owner_id \&quot;Polymorphic FK\&quot;\n        char_3 currency \&quot;Default LKR\&quot;\n        timestamptz created_at\n    }\n\n    WALLET_LEDGER_ENTRIES {\n        bigint id PK \&quot;IMMUTABLE APPEND-ONLY (Trigger Enforced)\&quot;\n        uuid txn_id \&quot;Balanced Double-Entry Group\&quot;\n        bigint account_id FK\n        bigint trip_id FK \&quot;core.trips(id)\&quot;\n        bigint user_id FK \&quot;core.users(id)\&quot;\n        bigint amount_minor \&quot;CHECK (amount_minor &gt; 0) LKR cents\&quot;\n        text direction \&quot;CREDIT | DEBIT\&quot;\n        text reason \&quot;trip_share | fuel_reimbursement | topup | adjustment\&quot;\n        text idempotency_key UK\n        timestamptz created_at\n    }\n\n    WALLET_VOUCHERS {\n        text code PK\n        bigint company_id FK\n        bigint amount_minor\n        timestamptz expires_at\n        bigint redeemed_by FK \&quot;core.users(id)\&quot;\n    }\n\n    CARBON_TRIP_EMISSIONS {\n        bigint trip_id PK, FK \&quot;core.trips(id)\&quot;\n        bigint company_id FK\n        real distance_km\n        real co2_kg\n        real co2_avoided_kg\n        real occupancy\n        timestamptz occurred_at\n    }\n\n    %% =========================================================================\n    %% SAFETY SCHEMA (Module 4 - Amaraweera MTP - Telematics, Anomaly &amp; OTP)\n    %% =========================================================================\n    SAFETY_TRACKING_POINTS {\n        bigint id PK\n        bigint trip_id FK\n        bigint user_id FK\n        geometry_point_4326 geom \&quot;GiST Spatial Index\&quot;\n        real speed_mps\n        real heading\n        real accuracy_m\n        timestamptz recorded_at\n        timestamptz received_at\n    }\n\n    SAFETY_ROUTE_BOUNDARIES {\n        bigint trip_id PK, FK \&quot;1:1 Weak Entity on core.trips\&quot;\n        geometry_linestring_4326 geom \&quot;Planned Polyline from Module 1\&quot;\n        int mild_threshold_m \&quot;Default 250m\&quot;\n        int severe_threshold_m \&quot;Default 1000m\&quot;\n        timestamptz created_at\n    }\n\n    SAFETY_SOS_EVENTS {\n        bigint id PK\n        bigint trip_id FK\n        bigint user_id FK\n        text trigger \&quot;manual | auto_anomaly\&quot;\n        geometry_point_4326 geom \&quot;GiST Spatial Index\&quot;\n        text status \&quot;open | acknowledged | resolved\&quot;\n        timestamptz created_at\n        timestamptz resolved_at\n        bigint resolved_by FK \&quot;core.users(id)\&quot;\n        text note\n    }\n\n    SAFETY_ANOMALY_LOG {\n        bigint id PK\n        bigint trip_id FK\n        bigint user_id FK\n        text level \&quot;warning | admin_alert | auto_sos | stall | trip_end\&quot;\n        real distance_m\n        geometry_point_4326 geom\n        jsonb details\n        timestamptz created_at\n    }\n\n    SAFETY_VERIFIED_USERS {\n        bigint user_id PK, FK \&quot;SUBTYPE of core.users (OTP Verified)\&quot;\n        citext corporate_email UK\n        timestamptz verified_at\n    }\n\n    SAFETY_OTP_REQUESTS {\n        bigint id PK\n        bigint user_id FK\n        citext email\n        text otp_hash \&quot;HMAC-SHA256\&quot;\n        timestamptz expires_at\n        int attempts \&quot;Max 5\&quot;\n        boolean consumed\n        timestamptz created_at\n    }\n\n    SAFETY_SAFETY_PREFERENCES {\n        bigint user_id PK, FK \&quot;1:1 Profile Extension of core.users\&quot;\n        boolean women_only\n        text emergency_contact_name\n        text emergency_contact_phone\n        text emergency_contact_email\n        timestamptz updated_at\n    }\n\n    %% =========================================================================\n    %% ANALYTICS SCHEMA (Module 5 - Kulapputhanthri AJ - BI, ETL &amp; Privacy)\n    %% =========================================================================\n    ANALYTICS_ZONES {\n        serial id PK\n        text name\n        text code UK \&quot;CMB-01, CMB-02...\&quot;\n        geometry_polygon_4326 geom \&quot;GiST Spatial Index\&quot;\n        timestamptz created_at\n    }\n\n    ANALYTICS_FACT_TRIPS {\n        bigint trip_id PK, FK \&quot;ETL-loaded from core.trips\&quot;\n        bigint company_id FK\n        text department\n        text kind \&quot;carpool | shuttle | solo\&quot;\n        timestamptz started_at\n        timestamptz ended_at\n        real distance_km\n        real occupancy\n        int seats_offered\n        int seats_used\n        bigint fuel_reimbursed_minor\n        real co2_kg\n        real co2_avoided_kg\n        int origin_zone_id FK \&quot;analytics.zones(id)\&quot;\n        int dest_zone_id FK \&quot;analytics.zones(id)\&quot;\n        timestamptz loaded_at\n    }\n\n    ANALYTICS_COMPANY_CONSENT {\n        bigint company_id PK, FK \&quot;1:1 with core.companies\&quot;\n        boolean shared_for_urban_planning\n        timestamptz consented_at\n        timestamptz updated_at\n    }\n\n    ANALYTICS_PRIVACY_BUDGET_LEDGER {\n        bigint id PK\n        text principal_id \&quot;Policymaker / API User ID\&quot;\n        text dataset \&quot;colombo_commute_flows\&quot;\n        real epsilon_spent \&quot;Laplace DP composition\&quot;\n        text query_hash\n        jsonb cached_result \&quot;Prevents averaging attacks\&quot;\n        timestamptz created_at\n    }\n\n    ANALYTICS_ETL_WATERMARKS {\n        text source PK\n        timestamptz last_loaded_at\n        bigint records_processed\n        timestamptz updated_at\n    }\n\n    ANALYTICS_ETL_ISSUES {\n        bigint id PK\n        text source\n        text record_identifier\n        text issue_type\n        jsonb details\n        timestamptz detected_at\n    }\n\n    %% =========================================================================\n    %% EER RELATIONSHIPS (Cardinalities, Generalizations &amp; Weak Dependencies)\n    %% =========================================================================\n\n    %% --- CORE Relationships ---\n    CORE_COMPANIES ||--o{ CORE_USERS : \&quot;employs\&quot;\n    CORE_COMPANIES ||--o{ CORE_TRIPS : \&quot;sponsors\&quot;\n    CORE_USERS ||--o{ CORE_TRIPS : \&quot;drives (driver_user_id)\&quot;\n    CORE_TRIPS ||--o{ CORE_TRIP_PARTICIPANTS : \&quot;has_participant\&quot;\n    CORE_USERS ||--o{ CORE_TRIP_PARTICIPANTS : \&quot;participates_in\&quot;\n\n    %% --- EER SUBTYPE / SUPERTYPE &amp; 1:1 EXTENSIONS OF CORE_USERS ---\n    CORE_USERS ||--o| AUTH_CREDENTIALS : \&quot;has_credentials (1:1 Weak)\&quot;\n    CORE_USERS ||--o{ AUTH_REFRESH_TOKENS : \&quot;issued_tokens\&quot;\n    CORE_USERS ||--o| BOOKING_DRIVERS : \&quot;ISA_shuttle_driver (Subtype)\&quot;\n    CORE_USERS ||--o| SAFETY_VERIFIED_USERS : \&quot;ISA_verified_employee (Subtype)\&quot;\n    CORE_USERS ||--o| SAFETY_SAFETY_PREFERENCES : \&quot;has_safety_prefs (1:1)\&quot;\n    CORE_USERS ||--o{ SAFETY_OTP_REQUESTS : \&quot;requests_otp\&quot;\n\n    %% --- BOOKING Relationships ---\n    CORE_COMPANIES ||--o{ BOOKING_VEHICLES : \&quot;owns_fleet\&quot;\n    CORE_COMPANIES ||--o{ BOOKING_DRIVERS : \&quot;contracts_driver\&quot;\n    CORE_COMPANIES ||--o{ BOOKING_SHUTTLE_ROUTES : \&quot;operates_route\&quot;\n    BOOKING_VEHICLES ||--|{ BOOKING_SEATS : \&quot;contains_seats (Identifying)\&quot;\n    BOOKING_SHUTTLE_ROUTES ||--o{ BOOKING_SHUTTLE_TRIPS : \&quot;schedules_run\&quot;\n    BOOKING_VEHICLES ||--o{ BOOKING_SHUTTLE_TRIPS : \&quot;assigned_to_run\&quot;\n    BOOKING_DRIVERS ||--o{ BOOKING_SHUTTLE_TRIPS : \&quot;operates_run\&quot;\n    CORE_TRIPS ||--o| BOOKING_SHUTTLE_TRIPS : \&quot;ISA_shuttle_trip (Subtype)\&quot;\n    BOOKING_SHUTTLE_TRIPS ||--o{ BOOKING_BOOKINGS : \&quot;has_bookings\&quot;\n    CORE_USERS ||--o{ BOOKING_BOOKINGS : \&quot;makes_booking\&quot;\n    BOOKING_BOOKINGS ||--|{ BOOKING_SEAT_ASSIGNMENTS : \&quot;allocates\&quot;\n    BOOKING_SHUTTLE_TRIPS ||--o{ BOOKING_SEAT_ASSIGNMENTS : \&quot;tracks_trip_seat\&quot;\n    BOOKING_SEATS ||--o{ BOOKING_SEAT_ASSIGNMENTS : \&quot;assigned_in\&quot;\n    BOOKING_SHUTTLE_TRIPS ||--o{ BOOKING_WAITLIST_ENTRIES : \&quot;queues_in_fifo\&quot;\n    CORE_USERS ||--o{ BOOKING_WAITLIST_ENTRIES : \&quot;joins_waitlist\&quot;\n    BOOKING_SHUTTLE_TRIPS ||--o{ BOOKING_SEAT_HOLDS : \&quot;holds_temporarily\&quot;\n    BOOKING_SEATS ||--o{ BOOKING_SEAT_HOLDS : \&quot;locked_by_hold\&quot;\n    CORE_USERS ||--o{ BOOKING_SEAT_HOLDS : \&quot;holds_seat\&quot;\n    BOOKING_BOOKINGS ||--o{ BOOKING_BOOKING_AUDIT : \&quot;audits_state_transition\&quot;\n    CORE_USERS ||--o{ BOOKING_BOOKING_AUDIT : \&quot;triggered_by_actor\&quot;\n    CORE_USERS ||--o{ BOOKING_IDEMPOTENCY_KEYS : \&quot;scopes_idempotency\&quot;\n    BOOKING_BOOKINGS ||--o{ BOOKING_DOMAIN_EVENTS : \&quot;emits_outbox_event\&quot;\n\n    %% --- ROUTING Relationships ---\n    ROUTING_ROAD_NODES ||--o{ ROUTING_ROAD_EDGES : \&quot;source_vertex\&quot;\n    ROUTING_ROAD_NODES ||--o{ ROUTING_ROAD_EDGES : \&quot;target_vertex\&quot;\n    CORE_USERS ||--o{ ROUTING_RIDE_OFFERS : \&quot;offers_carpool\&quot;\n    CORE_USERS ||--o{ ROUTING_RIDE_REQUESTS : \&quot;requests_carpool\&quot;\n    ROUTING_RIDE_OFFERS ||--o{ ROUTING_MATCHES : \&quot;matched_in\&quot;\n    ROUTING_RIDE_REQUESTS ||--o{ ROUTING_MATCHES : \&quot;satisfied_by\&quot;\n    ROUTING_MATCHES ||--o| CORE_TRIPS : \&quot;spawns_carpool_trip (Subtype)\&quot;\n\n    %% --- WALLET &amp; CARBON Relationships ---\n    WALLET_FUEL_TYPES ||--o{ WALLET_VEHICLE_TYPES : \&quot;powers\&quot;\n    WALLET_FUEL_TYPES ||--o{ WALLET_EMISSION_FACTORS : \&quot;has_defra_factor\&quot;\n    WALLET_VEHICLE_TYPES ||--o{ WALLET_EMISSION_FACTORS : \&quot;refines_factor\&quot;\n    WALLET_FUEL_TYPES ||--o{ WALLET_FUEL_PRICES : \&quot;priced_at\&quot;\n    WALLET_VEHICLE_TYPES ||--o{ WALLET_VEHICLES_REGISTRY : \&quot;classifies\&quot;\n    CORE_USERS ||--o{ WALLET_VEHICLES_REGISTRY : \&quot;registers_personal_vehicle\&quot;\n    CORE_USERS ||--o| WALLET_ACCOUNTS : \&quot;owns_user_wallet (owner_type=user)\&quot;\n    CORE_COMPANIES ||--o| WALLET_ACCOUNTS : \&quot;owns_company_wallet (owner_type=company)\&quot;\n    WALLET_ACCOUNTS ||--o{ WALLET_LEDGER_ENTRIES : \&quot;records_immutable_leg\&quot;\n    CORE_TRIPS ||--o{ WALLET_LEDGER_ENTRIES : \&quot;settles_trip_cost\&quot;\n    CORE_USERS ||--o{ WALLET_LEDGER_ENTRIES : \&quot;transacted_for_user\&quot;\n    CORE_COMPANIES ||--o{ WALLET_VOUCHERS : \&quot;issues_voucher\&quot;\n    CORE_USERS ||--o{ WALLET_VOUCHERS : \&quot;redeems_voucher\&quot;\n    CORE_TRIPS ||--o| CARBON_TRIP_EMISSIONS : \&quot;calculates_emissions\&quot;\n    CORE_COMPANIES ||--o{ CARBON_TRIP_EMISSIONS : \&quot;aggregates_scope3\&quot;\n\n    %% --- SAFETY Relationships ---\n    CORE_TRIPS ||--o| SAFETY_ROUTE_BOUNDARIES : \&quot;bounded_by_polyline (1:1 Weak)\&quot;\n    CORE_TRIPS ||--o{ SAFETY_TRACKING_POINTS : \&quot;streams_gps_telemetry\&quot;\n    CORE_USERS ||--o{ SAFETY_TRACKING_POINTS : \&quot;transmits_location\&quot;\n    CORE_TRIPS ||--o{ SAFETY_ANOMALY_LOG : \&quot;flags_deviation_or_stall\&quot;\n    CORE_USERS ||--o{ SAFETY_ANOMALY_LOG : \&quot;monitored_subject\&quot;\n    CORE_TRIPS ||--o{ SAFETY_SOS_EVENTS : \&quot;triggers_emergency\&quot;\n    CORE_USERS ||--o{ SAFETY_SOS_EVENTS : \&quot;initiates_sos\&quot;\n    CORE_USERS ||--o{ SAFETY_SOS_EVENTS : \&quot;resolves_sos (resolved_by)\&quot;\n\n    %% --- ANALYTICS Relationships ---\n    CORE_TRIPS ||--o| ANALYTICS_FACT_TRIPS : \&quot;etl_loads_into\&quot;\n    CORE_COMPANIES ||--o{ ANALYTICS_FACT_TRIPS : \&quot;grouped_by_company\&quot;\n    ANALYTICS_ZONES ||--o{ ANALYTICS_FACT_TRIPS : \&quot;originates_in_zone\&quot;\n    ANALYTICS_ZONES ||--o{ ANALYTICS_FACT_TRIPS : \&quot;terminates_in_zone\&quot;\n    CORE_COMPANIES ||--o| ANALYTICS_COMPANY_CONSENT : \&quot;grants_dp_consent (1:1)\&quot;\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="LWkN_2NUAptw6wogCjiw-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
